modules = ["python-base-3.13"]
[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "unity-source"

[[workflows.workflow]]
name = "unity-source"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 tools/validate_unity_source.py"

[workflows.workflow.metadata]
isValidation = true

[postMerge]
path = "tools/post-merge-setup.sh"
timeoutMs = 120000
